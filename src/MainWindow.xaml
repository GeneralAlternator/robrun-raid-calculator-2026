<Window x:Class="ROBRUNRaidCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROB RUN Raid Calculator"
        Height="540"
        Width="860"
        Background="#121212">
    <Grid>
        <TabControl x:Name="MainTabControl">
            <TabItem Header="Raid Calculator">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Building:" FontWeight="Bold" VerticalAlignment="Center" />
                        <ComboBox x:Name="BuildingComboBox" Width="180" Margin="8,0,8,0" />
                        <TextBlock Text="Fuse rarity:" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,8,0" />
                        <ComboBox x:Name="FuseComboBox" Width="140" Margin="0,0,8,0" />
                    </StackPanel>
                    <Button x:Name="CalculateButton" Content="Calculate" Click="CalculateButton_Click" Grid.Row="1" Margin="0,0,0,8" Width="140" />
                    <TextBlock x:Name="RaidResultTextBlock" Grid.Row="2" Text="Result will appear here." FontSize="16" FontWeight="Bold" />
                    <TextBlock x:Name="ProfitResultTextBlock" Grid.Row="3" Text="Profit estimate will appear here." />
                </Grid>
            </TabItem>
            <TabItem Header="Laundering Timer">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Dirty cash amount:" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBox x:Name="DirtyCashTextBox" Width="140" Margin="8,0,8,0" />
                    </StackPanel>
                    <Button x:Name="StartTimerButton" Content="Start Timer" Click="StartTimerButton_Click" Grid.Row="1" Margin="0,0,0,8" Width="140" />
                    <TextBlock x:Name="TimerStatusTextBlock" Grid.Row="2" Text="Timer is idle." FontSize="16" FontWeight="Bold" />
                    <Button x:Name="StopTimerButton" Content="Stop" Click="StopTimerButton_Click" Grid.Row="3" Width="90" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
